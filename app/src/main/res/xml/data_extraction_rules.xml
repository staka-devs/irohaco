<?xml version="1.0" encoding="utf-8"?>
<!-- docs/android/BACKUP_POLICY.md: no OS cloud backup and no device-to-device transfer.
     root is the whole app data directory (files, databases, shared_prefs); external is getExternalFilesDir. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
